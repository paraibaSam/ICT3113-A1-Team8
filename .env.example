# Copy this to .env and set the model the service should call.
# Candidates (pull each first: docker compose exec ollama ollama pull <tag>):
#   gemma3:1b  gemma3:4b  qwen2.5:3b  qwen2.5:7b  granite3.3:8b
# The tag must match exactly; digests are listed in the README.
OLLAMA_MODEL=gemma3:4b

# --- Assignment 2 cascade (docs/escalation_rule.md) ---
# Leave all three unset/empty for single-model mode (uses OLLAMA_MODEL, as in A1).
# Set all three for cascade mode (OLLAMA_MODEL is then ignored).
# Setting A:
# CASCADE_SMALL_MODEL=gemma3:4b
# CASCADE_LARGE_MODEL=qwen2.5:7b
# CASCADE_ESCALATE=Credit card
# Setting B:
# CASCADE_SMALL_MODEL=gemma3:4b
# CASCADE_LARGE_MODEL=qwen2.5:7b
# CASCADE_ESCALATE=Debt collection,Credit card
